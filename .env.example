# Скопируйте этот файл в .env (docker-compose подхватит его автоматически)
# и при желании поменяйте значения. Для локальной разработки дефолты ниже
# использовать можно — они не секретны и не идут в прод.
#
#   cp .env.example .env

# --- Frontend ---
FRONTEND_PORT=3000

# --- Backend ---
# Docker-настройка backend (+ redis/s3) сейчас не входит в этот
# репозиторий, появится отдельно вместе с инициализацией NestJS.
# BACKEND_PORT используется только как дефолт для NEXT_PUBLIC_API_URL
# во frontend-сервисе (docker-compose.yml) — backend может слушать этот
# порт локально, вне Docker.
BACKEND_PORT=4001

# --- Postgres ---
# Поднимается в Docker (см. docker-compose.yml, сервис postgres).
# Backend запускается локально, вне Docker, и подключается через
# DATABASE_URL ниже (localhost, т.к. порт проброшен на хост).
POSTGRES_USER=interviewly
POSTGRES_PASSWORD=interviewly
POSTGRES_DB=interviewly
POSTGRES_PORT=5432
DATABASE_URL=postgresql://interviewly:interviewly@localhost:5432/interviewly?schema=public
