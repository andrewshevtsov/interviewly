# Скопируйте этот файл в .env (docker-compose подхватит его автоматически)
# и при желании поменяйте значения. Для локальной разработки дефолты ниже
# использовать можно — они не секретны и не идут в прод.
#
#   cp .env.example .env

# --- Frontend ---
FRONTEND_PORT=3000
# NEXT_PUBLIC_API_URL используется frontend-сервисом для запросов к backend
# из браузера, поэтому указывает на localhost, а не на имя сервиса в Docker-сети.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Локально ws://. В проде server.sh ставит wss://collaboration.<домен> (TLS-прокси Caddy).
NEXT_PUBLIC_COLLABORATION_URL=ws://localhost:1234
# На сервере prod-compose сам запускает next start; локально в Docker — next dev.
# FRONTEND_SCRIPT=start
# Username бота (без @) для кнопки "Log in with Telegram" (features/telegram-login).
# Пусто по умолчанию - без него кнопка просто не рендерится (см. TelegramLoginButton),
# ручное тестирование самого /auth/telegram без неё не страдает - см.
# docs/dev/telegram-auth-manual-testing.md. Заполните реальным username, когда у бота
# будет привязан домен через `/setdomain` в @BotFather (см. TELEGRAM_BOT_TOKEN ниже).
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# --- Backend ---
# BACKEND_PORT используется как дефолт для NEXT_PUBLIC_API_URL
# во frontend-сервисе (docker-compose.yml).
BACKEND_PORT=4000
# Порт Prometheus-метрик backend (отдельный от основного, наружу не публикуется)
METRICS_PORT=9100
COLLABORATION_PORT=1234
# Публичный порт отдельного coderunner-контейнера.
CODERUNNER_PORT=3003
# Разрешённый CORS-origin для запросов с фронтенда (см. apps/backend/src/main.ts).
FRONTEND_URL=http://localhost:3000

# --- Внутренние адреса сервисов при локальном запуске вне Docker ---
# В Compose эти значения переопределяются DNS-именами backend и piston.
# BACKEND_INTERNAL_URL — адрес backend для серверных компонентов Next.js.
# Локально он совпадает с NEXT_PUBLIC_API_URL.
BACKEND_INTERNAL_URL=http://localhost:4000
CODERUNNER_INTERNAL_URL=http://localhost:3003
COLLABORATION_INTERNAL_URL=http://localhost:1234
PISTON_URL=http://localhost:2000
# Общий секрет только для внутренних HTTP-вызовов backend/coderunner/collaboration.
INTERNAL_SERVICE_TOKEN=dev-internal-service-token-change-me

# --- Postgres ---
# Поднимается в Docker (см. docker-compose.yml, сервис postgres).
# Backend тоже запускается в Docker (сервис backend) и подключается
# к postgres по имени сервиса в сети docker-compose - поэтому в
# DATABASE_URL ниже хост "postgres", а не "localhost".
POSTGRES_USER=interviewly
POSTGRES_PASSWORD=interviewly
POSTGRES_DB=interviewly
POSTGRES_PORT=5432
DATABASE_URL=postgresql://interviewly:interviewly@postgres:5432/interviewly?schema=public

# --- Auth (JWT) ---
# Dev-значения, не для прода: access-токен короткоживущий, refresh — длинный.
# В проде задайте длинные случайные строки и разные секреты для двух типов токенов.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_EXPIRES_IN=45m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=7d

# Для локальных тестов.
# --- Auth (Telegram Login Widget) / Bot API ---
# Токен бота из @BotFather (`/newbot`). Нужен backend'у, чтобы проверять
# HMAC-подпись данных, присланных виджетом (см. auth/utils/telegram-auth.util.ts),
# слать уведомления и отвечать на /start.
# Для реального логина через Telegram домен бота нужно привязать через
# `/setdomain` в @BotFather - на dev-значение ниже виджет работать не будет,
# но backend с ним поднимается и корректно отклоняет любые telegram-запросы.
TELEGRAM_BOT_TOKEN=dev-telegram-bot-token-change-me
# HTTP-прокси до api.telegram.org (CONNECT), если Telegram недоступен напрямую.
# Формат: user:pass@host:port или http://user:pass@host:port. Пусто - без прокси.
# TG_PROXY=

# --- AI (DeepSeek) ---
# AI-подсказки в комнате (POST /sessions/:id/hints). Ключ: https://platform.deepseek.com/api_keys
# Без ключа backend стартует, но запрос подсказки отвечает 503.
# Модель: deepseek-flash (быстрая, режим рассуждений отключаем в запросе).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Временно, пока нет реалтайм-редактора: интервьюер кнопкой «новая задача» показывает в комнате
# демо-задачу (условие + код на JS/TS, session-hints/demo-tasks.ts), подсказка строится по ней.
# Фронт узнаёт о режиме из GET /sessions/:id/demo-task - отдельный флаг ему не нужен.
AI_HINTS_DEMO_CONTEXT=true

# --- LiveKit ---
# Backend: livekit-server-sdk выпускает participant JWT (POST /sessions/:id/livekit-token).
# SFU: docker compose up -d livekit (конфиг infra/livekit/livekit.yaml).
# Ключи ниже ОБЯЗАНЫ совпадать с секцией keys в livekit.yaml.
#
# Postman (комнаты + заявки):
#   GET  /sessions/permissions          — матрица прав
#   GET  /sessions                      — только свои (admin — все), без участников
#   GET  /sessions/:id/participants     — count+список (host/участники)
#   POST /sessions/:id/access-requests  — заявка (OPEN/PASSWORD)
#   POST /sessions/:id/access-requests/:requestId/approve  — только HOST
#   POST /sessions/:id/join             — вход принятого участника
#   POST /sessions/:id/livekit-token    — JWT; отключает от другой активной комнаты
#
# WebRTC (не Postman): вставьте serverUrl + token в https://meet.livekit.io/custom
# (два браузера / инкогнито с token’ами interviewer и candidate).
# Локально ws://localhost:7880. В проде — wss://livekit.<домен> через Caddy (без :7880).
# RTC по-прежнему идёт на IP хоста :7881/:7882 (см. infra/livekit/livekit.yaml node_ip).
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=interviewly_livekit_dev_secret_32chars
LIVEKIT_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_PORT=7882
# Публичный URL для браузера (когда появится frontend-клиент):
# NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# --- Уведомления: Redis (очередь BullMQ) ---
# Очередь доставляет уведомления о матчах и напоминания за 2 часа до встречи.
# В Docker backend получает REDIS_URL из docker-compose.yml; для локального backend
# значение по умолчанию redis://localhost:6379 подходит, если не меняли REDIS_PORT.
REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379

# --- Уведомления: почта (nodemailer) ---
# Письма уходят тем, у кого не привязан Telegram. В разработке их ловит Mailpit
# (docker compose up -d mailpit): веб-интерфейс http://localhost:8025.
# Значения по умолчанию - SMTP_HOST=localhost, SMTP_PORT=1025 (Mailpit); в проде задайте реальный SMTP.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Interviewly <no-reply@interviewly.local>

# Уведомления в Telegram отправляет бот из TELEGRAM_BOT_TOKEN (см. выше). Писать можно только тем,
# кто вошёл через Telegram Login Widget (виджет запрашивает право писать) или сам нажал /start у бота.
# TELEGRAM_API_URL=https://api.telegram.org   # менять только для тестов с заглушкой
# Webhook бота (ответ на /start). Секрет - любая случайная строка: Telegram присылает её в заголовке
# каждого запроса, без совпадения backend отвечает 401. Если TELEGRAM_WEBHOOK_URL задан, backend сам
# вызывает setWebhook при старте. Без URL backend сам поднимает long polling (getUpdates) — /start
# работает локально, нужен только исходящий доступ к api.telegram.org (см. TG_PROXY).
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_WEBHOOK_URL=https://<домен-туннеля-бэкенда>/telegram/webhook

# --- Мониторинг (docker compose --profile monitoring up -d) ---
# Grafana: http://localhost:3001, Prometheus: http://localhost:9090.
# В проде пароль-заглушка заменяется на случайный при деплое (infra/deploy/server.sh).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=password_change_me
# GRAFANA_ROOT_URL=http://localhost:3001
# Пароль роли grafana_reader (Postgres, только чтение); включается infra/postgres/grafana-reader.sh
GRAFANA_DB_PASSWORD=password_change_me

# --- Ошибки: GlitchTip (docker compose --profile errors up -d glitchtip glitchtip-postgres) ---
# Интерфейс: http://localhost:8000. В проде заглушки заменяются случайными значениями при деплое.
GLITCHTIP_SECRET_KEY=password_change_me
GLITCHTIP_DB_PASSWORD=password_change_me
# GLITCHTIP_DOMAIN=http://localhost:8000
# DSN проекта backend из GlitchTip (Project -> Settings). Пусто - ошибки никуда не отправляются.
# В Docker GlitchTip доступен по имени сервиса: http://<ключ>@glitchtip:8000/<id проекта>
SENTRY_DSN=
# DSN проекта frontend. Публичный (попадает в браузер при сборке образа). Пусто - ошибки не отправляются.
# Локально браузер ходит на http://<ключ>@localhost:8000/<id>; в проде значение задаётся переменной
# NEXT_PUBLIC_SENTRY_DSN в GitHub (Settings -> Variables), см. docs/monitoring.md
NEXT_PUBLIC_SENTRY_DSN=
