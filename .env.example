# Скопируйте этот файл в .env (docker-compose подхватит его автоматически)
# и при желании поменяйте значения. Для локальной разработки дефолты ниже
# использовать можно — они не секретны и не идут в прод.
#
#   cp .env.example .env

# --- Frontend ---
FRONTEND_PORT=3000
# NEXT_PUBLIC_API_URL используется frontend-сервисом для запросов к backend
# из браузера, поэтому указывает на localhost, а не на имя сервиса в Docker-сети.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Username бота (без @) для кнопки "Log in with Telegram" (features/telegram-login).
# Пусто по умолчанию - без него кнопка просто не рендерится (см. TelegramLoginButton),
# ручное тестирование самого /auth/telegram без неё не страдает - см.
# docs/dev/telegram-auth-manual-testing.md. Заполните реальным username, когда у бота
# будет привязан домен через `/setdomain` в @BotFather (см. TELEGRAM_BOT_TOKEN ниже).
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# --- Backend ---
# BACKEND_PORT используется как дефолт для NEXT_PUBLIC_API_URL
# во frontend-сервисе (docker-compose.yml).
BACKEND_PORT=4000
# Разрешённый CORS-origin для запросов с фронтенда (см. apps/backend/src/main.ts).
FRONTEND_URL=http://localhost:3000

# --- Postgres ---
# Поднимается в Docker (см. docker-compose.yml, сервис postgres).
# Backend тоже запускается в Docker (сервис backend) и подключается
# к postgres по имени сервиса в сети docker-compose - поэтому в
# DATABASE_URL ниже хост "postgres", а не "localhost".
POSTGRES_USER=interviewly
POSTGRES_PASSWORD=interviewly
POSTGRES_DB=interviewly
POSTGRES_PORT=5432
DATABASE_URL=postgresql://interviewly:interviewly@postgres:5432/interviewly?schema=public

# --- Auth (JWT) ---
# Dev-значения, не для прода: access-токен короткоживущий, refresh — длинный.
# В проде задайте длинные случайные строки и разные секреты для двух типов токенов.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_EXPIRES_IN=45m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=7d

# --- Auth (Telegram Login Widget) ---
# Токен бота из @BotFather (`/newbot`). Нужен backend'у, чтобы проверять
# HMAC-подпись данных, присланных виджетом (см. auth/utils/telegram-auth.util.ts).
# Для реального логина через Telegram домен бота нужно привязать через
# `/setdomain` в @BotFather - на dev-значение ниже виджет работать не будет,
# но backend с ним поднимается и корректно отклоняет любые telegram-запросы.
TELEGRAM_BOT_TOKEN=dev-telegram-bot-token-change-me

# --- LiveKit ---
# Backend: livekit-server-sdk выпускает participant JWT (POST /sessions/:id/livekit-token).
# SFU: docker compose up -d livekit (конфиг infra/livekit/livekit.yaml).
# Ключи ниже ОБЯЗАНЫ совпадать с секцией keys в livekit.yaml.
#
# Postman (комнаты + заявки):
#   GET  /sessions/permissions          — матрица прав
#   GET  /sessions                      — только свои (admin — все), без участников
#   GET  /sessions/:id/participants     — count+список (host/участники)
#   POST /sessions/:id/access-requests  — заявка (OPEN/PASSWORD)
#   POST /sessions/:id/access-requests/:requestId/approve  — только HOST
#   POST /sessions/:id/join             — вход принятого участника
#   POST /sessions/:id/livekit-token    — JWT; отключает от другой активной комнаты
#
# WebRTC (не Postman): вставьте serverUrl + token в https://meet.livekit.io/custom
# (два браузера / инкогнито с token’ами interviewer и candidate).
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=interviewly_livekit_dev_secret_32chars
LIVEKIT_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_PORT=7882
# Публичный URL для браузера (когда появится frontend-клиент):
# NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
