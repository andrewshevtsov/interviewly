# Зависимости — ставятся заново внутри образа, тащить их из хоста
# бессмысленно и может сломать сборку (разные ОС/архитектуры бинарников).
node_modules
**/node_modules

# Сборочные артефакты — пересобираются внутри контейнера.
dist
**/dist
.next
**/.next
*.tsbuildinfo
**/*.tsbuildinfo

# git и IDE — не нужны внутри образа.
.git
.gitignore
.vscode
.idea

# Секреты/локальные переменные окружения не должны попадать
# в образ (иначе останутся в слоях образа даже после удаления файла).
.env
.env.*
!.env.example

# Документация и отчёты — не нужны для сборки/выполнения.
README.md
*.md

# Логи и системные файлы.
*.log
.DS_Store
