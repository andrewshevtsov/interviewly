# TLS-прокси для прода. WebSocket (LiveKit signaling, collaboration) идут по
# wss:// через 443 — иначе браузер на https-сайте блокирует ws:// (mixed content).
#
# Сертификаты: Cloudflare Origin CA (или свои) в /etc/caddy/certs/.
# Подстановка домена: server.sh пишет PUBLIC_HOST вместо interviewly.top при деплое.
#
# RTC (UDP/TCP 7881/7882) остаётся на хост напрямую — LiveKit node_ip = публичный IP.

{
	admin off
}

interviewly.top, www.interviewly.top {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

	handle /api* {
		reverse_proxy 172.17.0.1:4000
	}

	handle {
		reverse_proxy 172.17.0.1:3000
	}
}

livekit.interviewly.top {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	reverse_proxy 172.17.0.1:7880
}

collaboration.interviewly.top {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	reverse_proxy 172.17.0.1:1234
}
