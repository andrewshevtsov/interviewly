// Тип, способ доступа и жизненный цикл сессии хранятся в PostgreSQL как enum.
enum SessionType {
  BUSINESS
  MOCK
}

enum SessionAccess {
  OPEN
  PASSWORD
  INVITE
}

enum SessionStatus {
  DRAFT
  SCHEDULED
  READY
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

// Права владельца комнаты определяются по Session.ownerId; сам владелец в комнате - INTERVIEWER
enum SessionParticipantRole {
  INTERVIEWER
  CANDIDATE
}

enum SessionAccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Session {
  id String @default(uuid()) @db.Uuid

  ownerId String @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id])

  // Задаётся при создании (необязательно); история интервью показывает
  // фолбэк на фронтенде для сессий без title.
  title           String?
  type            SessionType   @default(BUSINESS)
  access          SessionAccess @default(INVITE)
  // Для access=PASSWORD непустой хеш обязателен: это дополнительно защищено
  // CHECK-ограничением Session_password_required в начальной миграции.
  passwordHash    String?
  status          SessionStatus @default(READY)
  statusUpdatedAt DateTime      @default(now()) @db.Timestamptz(3)
  scheduledAt     DateTime?     @db.Timestamptz(3)
  startedAt       DateTime?     @db.Timestamptz(3)
  endedAt         DateTime?     @db.Timestamptz(3)
  livekitRoomName String        @unique
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  participants   SessionParticipant[]
  feedback     Feedback[]
  accessRequests SessionAccessRequest[]

  @@id([id])
}

model SessionParticipant {
  // Явная таблица связи User <-> Session. Составной первичный ключ ниже
  // запрещает повторное участие одного пользователя в одной сессии.
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  sessionId String  @db.Uuid
  session   Session @relation(fields: [sessionId], references: [id])

  role SessionParticipantRole @default(CANDIDATE)

  joinedAt       DateTime? @db.Timestamptz(3)
  leftAt         DateTime? @db.Timestamptz(3)
  reconnectCount Int       @default(0)
  offlineSeconds Int       @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@id([userId, sessionId])
  // Составной PK начинается с userId; отдельный индекс ускоряет обратный
  // запрос — получение всех участников по sessionId.
  @@index([sessionId])
  @@index([userId, leftAt])
}

model SessionAccessRequest {
  id String @default(uuid()) @db.Uuid

  sessionId String  @db.Uuid
  session   Session @relation(fields: [sessionId], references: [id])

  requesterId String @db.Uuid
  requester   User   @relation("SessionAccessRequester", fields: [requesterId], references: [id])

  status        SessionAccessRequestStatus @default(PENDING)
  requestedRole SessionParticipantRole     @default(CANDIDATE)

  reviewedById String? @db.Uuid
  reviewedBy   User?   @relation("SessionAccessReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@id([id])
  @@index([sessionId, status])
  @@index([requesterId])
}
