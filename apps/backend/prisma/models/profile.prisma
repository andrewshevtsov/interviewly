enum ProfessionLevel {
  junior
  middle
  senior
}

// Профиль пользователя (роль, уровень, стек, био). Связь 1:1 с User
model Profile {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @unique @db.Uuid
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses       ShowcaseResponse[]
  role            String
  level           ProfessionLevel
  stack           String[]
  // Теги стека в нижнем регистре для поиска без учёта регистра. Заполняет триггер
  // Profile_stackSearch_trigger при любой записи в stack: руками не писать.
  stackSearch     String[]
  bio             String?
  // Пользователь сам включает показ профиля на витрине; по умолчанию скрыт.
  showcaseVisible Boolean         @default(false)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)

  @@index([showcaseVisible])
  @@index([stackSearch], type: Gin)
}
