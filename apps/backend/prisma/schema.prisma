// Главный файл Prisma-схемы содержит только источник данных и генератор.
// Модели и enum разнесены по предметным областям в prisma/models/*.prisma.
datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  // Сгенерированный код используется PrismaService, но не коммитится в git.
  // После изменения схемы обновите его командой `prisma generate`.
  output       = "../src/prisma/generated"
  // Backend компилируется как ESM (см. apps/backend/tsconfig.json).
  moduleFormat = "esm"
}
