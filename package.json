{
  "name": "mock-interview-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Сервис проведения технических и мок-интервью",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "back-dev": "pnpm --filter @app/backend run start:dev",
    "front-dev": "pnpm --filter @app/frontend run dev",
    "db-dev": "docker compose up -d postgres livekit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "prepare": "husky",
    "prisma-generate": "pnpm --filter @app/backend prisma-generate"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.17.0",
    "@types/node": "^24.13.3",
    "eslint": "10.1.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
