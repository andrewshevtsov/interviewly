{
  "name": "mock-interview-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Сервис проведения технических и мок-интервью",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "back-dev": "pnpm --filter @app/backend run start:dev",
    "front-dev": "pnpm --filter @app/frontend run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}